# =====================================================================
# Slotwise backend — environment. Copy to .env and fill in.
# Validated at startup: the server won't boot with missing/invalid values.
# =====================================================================

# ---------- Required ----------
# PostgreSQL connection string (local, Docker, Render, Neon, Supabase...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotwise
# At least 32 characters. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---------- Needed in production ----------
NODE_ENV=development
# Frontend URL(s) allowed by CORS and Socket.IO, comma-separated
CORS_ORIGINS=http://localhost:3000
# Free key from https://console.mistral.ai — leave empty to use the offline rule-based interpreter
MISTRAL_API_KEY=
# true for Neon / Supabase / external URLs that require TLS; false for local and Render's internal URL
DATABASE_SSL=false
# 1 when running behind one reverse proxy (Render, Railway, Fly) so rate limits see real client IPs
TRUST_PROXY=0

# ---------- Optional (defaults shown) ----------
PORT=4000
LOG_LEVEL=info
DATABASE_POOL_MAX=10
JWT_EXPIRES_IN=1d
DEFAULT_BUSINESS_SLUG=lumen-clinic
# AI_PROVIDER=mistral            # auto: mistral when MISTRAL_API_KEY is set, otherwise mock
MISTRAL_MODEL=mistral-small-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
AI_TIMEOUT_MS=15000
AI_HISTORY_WINDOW=12
AI_LOG_PROMPTS=true
RATE_LIMIT_CHAT_PER_MINUTE=20

# ---------- Tests only ----------
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/slotwise_test
